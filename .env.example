TZ=Europe/Amsterdam

# MQTT broker credentials, used by Grott and Home Assistant.
# After changing these, run ./scripts/mqtt-passwd.sh
MQTT_USER=homelab
MQTT_PASSWORD=change-me

# HTTPS for Home Assistant (docs/https.md). DuckDNS name pointing at the Pi's LAN IP, and the account token.
HA_DOMAIN=name.duckdns.org
DUCKDNS_TOKEN=change-me
